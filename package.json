{
  "name": "subflare",
  "private": true,
  "version": "0.0.0",
  "license": "AGPL-3.0-only",
  "type": "module",
  "cloudflare": {
    "bindings": {
      "SUBFLARE_TOKEN": {
        "description": "后台登录令牌（至少 8 位），请换成一串只有你知道的随机字符，例如在终端运行 `openssl rand -hex 16` 生成。部署后用它登录控制台。"
      },
      "DB": {
        "description": "D1 数据库，保存订阅、模板和拉取记录。保持默认即可，会自动创建。"
      },
      "KV": {
        "description": "KV 命名空间，缓存生成好的配置。保持默认即可，会自动创建。"
      }
    }
  },
  "scripts": {
    "gen:parsers": "node scripts/build-peggy.mjs",
    "predev": "npm run gen:parsers",
    "dev": "vite",
    "prebuild": "npm run gen:parsers",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "npm run build && vite preview",
    "deploy": "npm run build && wrangler deploy && npm run db:migrate:remote",
    "setup": "node scripts/setup.mjs",
    "cf-typegen": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.1",
    "@tanstack/react-query": "^5.104.4",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "js-yaml": "^4.3.2",
    "lucide-react": "^1.59.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "safe-regex2": "^5.1.2",
    "sonner": "^2.0.8",
    "uqr": "^0.1.3",
    "wouter": "^3.13.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.19.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "drizzle-kit": "^0.31.11",
    "oxlint": "^1.81.0",
    "peggy": "^5.1.0",
    "shadcn": "^4.22.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "wrangler": "^4.151.1"
  }
}
